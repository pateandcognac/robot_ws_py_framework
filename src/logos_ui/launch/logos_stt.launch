<launch>
  <arg name="backend" default="whisper"
       doc="Speech recognizer: whisper or nemotron."/>
  <arg name="finish_mode" default="end_phrases"
       doc="Wake-recording completion: end_phrases or vad."/>
  <arg name="vad_silence_timeout" default="1.5"
       doc="Seconds of VAD silence that finish a recording in vad mode."/>
  <arg name="nemotron_recording_vad_threshold" default="0.35"
       doc="Nemotron Silero threshold used only for VAD recording completion."/>
  <arg name="nemotron_wake_preroll_seconds" default="0.8"
       doc="Audio retained before a Nemotron wake detection and seeded into command ASR."/>
  <arg name="nemotron_ambient_preroll_seconds" default="0.35"
       doc="Audio prepended when Nemotron ambient VAD enters speech."/>
  <arg name="nemotron_ambient_vad_hangover_seconds" default="0.5"
       doc="Audio retained after Nemotron ambient VAD leaves speech."/>

  <node if="$(eval arg('backend') == 'whisper')"
        name="logos_ears_node"
        pkg="logos_ui"
        type="stt_node.py"
        output="screen">
    <param name="recording_vad_only"
           value="$(eval arg('finish_mode') == 'vad')"/>
    <param name="recording_vad_silence_timeout"
           value="$(arg vad_silence_timeout)"/>
  </node>

  <node if="$(eval arg('backend') == 'nemotron')"
        name="logos_ears_node"
        pkg="logos_ui"
        type="nemotron_stt_node.py"
        output="screen">
    <param name="recording_vad_only"
           value="$(eval arg('finish_mode') == 'vad')"/>
    <param name="recording_vad_silence_timeout"
           value="$(arg vad_silence_timeout)"/>
    <param name="recording_vad_threshold"
           value="$(arg nemotron_recording_vad_threshold)"/>
    <param name="wake_preroll_seconds"
           value="$(arg nemotron_wake_preroll_seconds)"/>
    <param name="ambient_preroll_seconds"
           value="$(arg nemotron_ambient_preroll_seconds)"/>
    <param name="ambient_vad_hangover_seconds"
           value="$(arg nemotron_ambient_vad_hangover_seconds)"/>
  </node>
</launch>
